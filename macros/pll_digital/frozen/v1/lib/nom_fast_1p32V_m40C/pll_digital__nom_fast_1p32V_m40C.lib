library (pll_digital) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1uA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : -40.0;
  nom_voltage                    : 1.32;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.04680,  0.07800,  0.12960,  0.21600,  0.36000,  0.60000");
  }
  type ("div_ratio") {
    base_type : array;
    data_type : bit;
    bit_width : 10;
    bit_from : 9;
    bit_to : 0;
  }
  type ("test_div_select") {
    base_type : array;
    data_type : bit;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0;
  }

  cell ("pll_digital") {
    area : 16258.033 
    is_macro_cell : true;
    pin("down") {
      direction : output;
      capacitance : 0.0120;
    }
    pin("enable") {
      direction : input;
      capacitance : 0.0162;
    }
    pin("feedback_clk") {
      direction : output;
      capacitance : 0.0056;
    }
    pin("pll_clk") {
      direction : output;
      capacitance : 0.0546;
    }
    pin("ref_clk") {
      direction : input;
      clock : true;
      capacitance : 0.0245;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.00100");
	}
	cell_fall(scalar) {
          values("0.00099");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.00104");
	}
	cell_fall(scalar) {
          values("0.00104");
	}
      }
    }
    pin("reset_n") {
      direction : input;
      capacitance : 0.0034;
    }
    pin("test_clk") {
      direction : output;
      capacitance : 0.0040;
    }
    pin("up") {
      direction : output;
      capacitance : 0.0149;
      timing() {
        related_pin : "ref_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.04680,  0.07800,  0.12960,  0.21600,  0.36000,  0.60000");
          values("0.12078,0.16762,0.19539,0.24099,0.31718,0.44403,0.65558");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.04680,  0.07800,  0.12960,  0.21600,  0.36000,  0.60000");
          values("0.01305,0.06773,0.10758,0.17411,0.28581,0.47209,0.78260");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.04680,  0.07800,  0.12960,  0.21600,  0.36000,  0.60000");
          values("0.12173,0.16378,0.18729,0.22573,0.28984,0.39650,0.57401");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.04680,  0.07800,  0.12960,  0.21600,  0.36000,  0.60000");
          values("0.01179,0.05638,0.08783,0.14071,0.22971,0.37852,0.62629");
	}
      }
    }
    pin("vco_clk") {
      direction : input;
      clock : true;
      capacitance : 0.0167;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.08150");
	}
	cell_fall(scalar) {
          values("0.08201");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.95868");
	}
	cell_fall(scalar) {
          values("0.10500");
	}
      }
    }
    bus("div_ratio") {
      bus_type : div_ratio;
      direction : input;
      capacitance : 0.0000;
    pin("div_ratio[9]") {
      direction : input;
      capacitance : 0.0061;
    }
    pin("div_ratio[8]") {
      direction : input;
      capacitance : 0.0045;
    }
    pin("div_ratio[7]") {
      direction : input;
      capacitance : 0.0042;
    }
    pin("div_ratio[6]") {
      direction : input;
      capacitance : 0.0041;
    }
    pin("div_ratio[5]") {
      direction : input;
      capacitance : 0.0041;
    }
    pin("div_ratio[4]") {
      direction : input;
      capacitance : 0.0041;
    }
    pin("div_ratio[3]") {
      direction : input;
      capacitance : 0.0041;
    }
    pin("div_ratio[2]") {
      direction : input;
      capacitance : 0.0043;
    }
    pin("div_ratio[1]") {
      direction : input;
      capacitance : 0.0041;
    }
    pin("div_ratio[0]") {
      direction : input;
      capacitance : 0.0041;
    }
    }
    bus("test_div_select") {
      bus_type : test_div_select;
      direction : input;
      capacitance : 0.0000;
    pin("test_div_select[1]") {
      direction : input;
      capacitance : 0.0122;
    }
    pin("test_div_select[0]") {
      direction : input;
      capacitance : 0.0153;
    }
    }
  }

}
