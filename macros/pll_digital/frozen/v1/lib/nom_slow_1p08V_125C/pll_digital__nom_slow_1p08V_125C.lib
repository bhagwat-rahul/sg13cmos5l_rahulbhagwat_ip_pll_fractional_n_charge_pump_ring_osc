library (pll_digital) {
  comment                        : "";
  delay_model                    : table_lookup;
  simulation                     : false;
  capacitive_load_unit (1,pF);
  leakage_power_unit             : 1pW;
  current_unit                   : "1uA";
  pulling_resistance_unit        : "1kohm";
  time_unit                      : "1ns";
  voltage_unit                   : "1v";
  library_features(report_delay_calculation);

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;


  nom_process                    : 1.0;
  nom_temperature                : 125.0;
  nom_voltage                    : 1.08;

  lu_table_template(template_1) {
    variable_1 : total_output_net_capacitance;
    index_1("0.00100,  0.04680,  0.07800,  0.12960,  0.21600,  0.36000,  0.60000");
  }
  type ("div_ratio") {
    base_type : array;
    data_type : bit;
    bit_width : 10;
    bit_from : 9;
    bit_to : 0;
  }
  type ("test_div_select") {
    base_type : array;
    data_type : bit;
    bit_width : 2;
    bit_from : 1;
    bit_to : 0;
  }

  cell ("pll_digital") {
    area : 16258.033 
    is_macro_cell : true;
    pin("down") {
      direction : output;
      capacitance : 0.0111;
    }
    pin("enable") {
      direction : input;
      capacitance : 0.0150;
    }
    pin("feedback_clk") {
      direction : output;
      capacitance : 0.0051;
    }
    pin("pll_clk") {
      direction : output;
      capacitance : 0.0490;
    }
    pin("ref_clk") {
      direction : input;
      clock : true;
      capacitance : 0.0241;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.00097");
	}
	cell_fall(scalar) {
          values("0.00095");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("0.00100");
	}
	cell_fall(scalar) {
          values("0.00099");
	}
      }
    }
    pin("reset_n") {
      direction : input;
      capacitance : 0.0030;
    }
    pin("test_clk") {
      direction : output;
      capacitance : 0.0040;
    }
    pin("up") {
      direction : output;
      capacitance : 0.0137;
      timing() {
        related_pin : "ref_clk";
        timing_type : rising_edge;
	cell_rise(template_1) {
          index_1("0.00100,  0.04680,  0.07800,  0.12960,  0.21600,  0.36000,  0.60000");
          values("0.27398,0.38533,0.45333,0.56542,0.75258,1.06468,1.58452");
	}
	rise_transition(template_1) {
          index_1("0.00100,  0.04680,  0.07800,  0.12960,  0.21600,  0.36000,  0.60000");
          values("0.02961,0.16119,0.25716,0.41697,0.68493,1.13195,1.87663");
	}
	cell_fall(template_1) {
          index_1("0.00100,  0.04680,  0.07800,  0.12960,  0.21600,  0.36000,  0.60000");
          values("0.27322,0.37410,0.43238,0.52793,0.68742,0.95287,1.39514");
	}
	fall_transition(template_1) {
          index_1("0.00100,  0.04680,  0.07800,  0.12960,  0.21600,  0.36000,  0.60000");
          values("0.02703,0.13437,0.21053,0.33780,0.55177,0.90875,1.50345");
	}
      }
    }
    pin("vco_clk") {
      direction : input;
      clock : true;
      capacitance : 0.0141;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.14824");
	}
	cell_fall(scalar) {
          values("0.15265");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
          values("2.15953");
	}
	cell_fall(scalar) {
          values("0.18803");
	}
      }
    }
    bus("div_ratio") {
      bus_type : div_ratio;
      direction : input;
      capacitance : 0.0000;
    pin("div_ratio[9]") {
      direction : input;
      capacitance : 0.0058;
    }
    pin("div_ratio[8]") {
      direction : input;
      capacitance : 0.0041;
    }
    pin("div_ratio[7]") {
      direction : input;
      capacitance : 0.0039;
    }
    pin("div_ratio[6]") {
      direction : input;
      capacitance : 0.0038;
    }
    pin("div_ratio[5]") {
      direction : input;
      capacitance : 0.0038;
    }
    pin("div_ratio[4]") {
      direction : input;
      capacitance : 0.0038;
    }
    pin("div_ratio[3]") {
      direction : input;
      capacitance : 0.0038;
    }
    pin("div_ratio[2]") {
      direction : input;
      capacitance : 0.0040;
    }
    pin("div_ratio[1]") {
      direction : input;
      capacitance : 0.0038;
    }
    pin("div_ratio[0]") {
      direction : input;
      capacitance : 0.0038;
    }
    }
    bus("test_div_select") {
      bus_type : test_div_select;
      direction : input;
      capacitance : 0.0000;
    pin("test_div_select[1]") {
      direction : input;
      capacitance : 0.0113;
    }
    pin("test_div_select[0]") {
      direction : input;
      capacitance : 0.0142;
    }
    }
  }

}
